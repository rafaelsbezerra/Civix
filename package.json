{
  "name": "civix",
  "version": "1.0.0",
  "description": "Plataforma Civix - Catálogo de Empresas",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --root frontend",
    "start": "tsx backend/src/server.ts",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts --root frontend",
    "lint": "eslint frontend",
    "test": "vitest run --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --root frontend"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
