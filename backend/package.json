{
  "name": "civix-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx src/server.ts",
    "test:contracts": "node scripts/test.runner.mjs tests/contracts.test.ts",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "test:users": "node scripts/test.runner.mjs tests/user.routes.test.ts",
    "test:foundation": "node scripts/test.runner.mjs tests/contracts.test.ts tests/company.routes.test.ts tests/user.routes.test.ts tests/http.adoption.test.ts tests/local.persistence.test.ts tests/logging.test.ts tests/logging.http.test.ts tests/logging.services.test.ts tests/storage.r2.test.ts tests/storage.integration.test.ts tests/users.roles.test.ts tests/users.provisioning.test.ts",
    "typecheck:foundation": "tsc -p tsconfig.foundation.json",
    "test:prisma": "node --test tests/prisma.tooling.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:show": "prisma migrate status",
    "prisma:apply": "prisma migrate deploy",
    "prisma:pull": "npx --no-install prisma db pull",
    "mock:user:create": "tsx scripts/mock.user.create.ts",
    "seed:staging": "tsx scripts/seed.staging.ts",
    "test:seed": "node --import tsx --test tests/staging.seed.test.ts",
    "test:local": "node --import tsx --test tests/local.persistence.test.ts",
    "test:logging": "node scripts/test.runner.mjs tests/logging.test.ts tests/logging.http.test.ts tests/logging.services.test.ts",
    "test:storage": "node scripts/test.runner.mjs tests/storage.r2.test.ts tests/storage.integration.test.ts tests/users.roles.test.ts tests/users.provisioning.test.ts",
    "test:platform": "node scripts/test.runner.mjs tests/platform.foundation.test.ts tests/platform.postgres.test.ts tests/platform.eligibility.test.ts tests/platform.companies.test.ts tests/platform.sales.test.ts tests/platform.sales.postgres.test.ts tests/platform.users.test.ts tests/platform.users.postgres.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@getbrevo/brevo": "^6.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "resend": "^6.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.5",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  }
}
